<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Reset Your Password</title>
</head>
<body>
  <h2>Hello <%= name %>,</h2>
  <p>You requested a password reset.</p>
  <p>Please click the link below to set a new password. This link will expire in 5 minutes:</p>

  <p>
    <a href="<%= resetUrl %>" target="_blank" style="color: #007bff; text-decoration: none;">Click here to reset your password</a>
  </p>

  <p>If you didn’t request this, you can ignore this email.</p>
</body>
</html>
