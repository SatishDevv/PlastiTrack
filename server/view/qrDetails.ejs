<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- TailwindCSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Font -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
      }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white shadow-xl rounded-2xl p-8 max-w-lg w-full relative z-10">
      <h1 class="text-2xl font-semibold text-gray-800 mb-6 text-center">
        📦 QR Assignment Details
      </h1>

      <ul class="space-y-4 text-gray-700">
        <li>
          <span class="font-semibold text-gray-900">From User:</span>
          <%= qrData.fromUser %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">To User:</span>
          <%= qrData.toUser %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">Container Name:</span>
          <%= qrData.containerName %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">Container Size:</span>
          <%= qrData.containerSize %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">Transaction ID:</span>
          <%= qrData.transactionId %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">Quantity:</span>
          <%= qrData.quantity %>
        </li>
        <li>
          <span class="font-semibold text-gray-900">Dispatch Date:</span>
          <%= qrData.dispatchDate %>
        </li>
      </ul>

      <div class="mt-8 text-center">
        <a 
          href="<%= process.env.FRONTEND_URL %>" 
          class="inline-flex items-center justify-center gap-2 bg-blue-600 text-white font-medium px-6 py-2 rounded-lg hover:bg-blue-700 transition"
        >
          <span>🔙</span> Back to Dashboard
        </a>
      </div>
    </div>
  </body>
</html>
